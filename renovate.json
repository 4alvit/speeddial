{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "npm"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "tools/browser-compatibility/**"
  ],
  "packageRules": [
    {
      "description": "Historical browser generations advance only together with the reviewed compatibility inventory.",
      "matchFileNames": [
        "tools/browser-compatibility/**"
      ],
      "enabled": false
    },
    {
      "description": "Toolkit workflow revisions and exact PIN/BROWSER_PIN constants in scripts/check-ci-policy.py require one independently reviewed qualification.",
      "matchManagers": [
        "github-actions",
        "custom.regex",
        "custom.jsonata"
      ],
      "matchPackageNames": [
        "victron-venus/venus-os-ci-toolkit",
        "https://github.com/victron-venus/venus-os-ci-toolkit"
      ],
      "enabled": false
    }
  ]
}
